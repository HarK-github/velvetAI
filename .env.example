# ==============================================================================
# velvetAI Environment Variables Template
# PLACEHOLDERS ONLY - NEVER COMMIT REAL CREDENTIALS
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# PostgreSQL 17 Database
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}?sslmode=disable
TEST_DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}_test?sslmode=disable
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Redis 7 (Queue and Cache)
REDIS_URL=redis://localhost:6379

# OIDC & Auth0 Authentication
OIDC_ISSUER=https://auth.example.test
OIDC_AUDIENCE=velvetai-api
OIDC_MOCK_ENABLED=true
AUTH0_ISSUER=https://dev-example.us.auth0.com/
AUTH0_AUDIENCE=https://velvetai.example/api
AUTH0_JWKS_URI=https://dev-example.us.auth0.com/.well-known/jwks.json

# Google Gemini / AI Provider Configuration
AI_PROVIDER=fake
GOOGLE_GENERATIVE_AI_API_KEY=placeholder_google_gemini_api_key
AI_MODEL=gemini-2.5-flash

# Security & Cryptographic Secrets
INTENT_SIGNING_KEY=placeholder_base64_es256_private_key_or_dev_secret
CONFIRMATION_TOKEN_SECRET=placeholder_dev_confirmation_secret_32_chars_long
ENVELOPE_ENCRYPTION_KEY=000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f

# Host & Origin Security Allowlists
ALLOWED_HOSTS=localhost:3000,127.0.0.1:3000,localhost:5173,127.0.0.1:5173,velvetai-api.onrender.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://velvetai.onrender.com

# PayPal Sandbox Configuration
PAYPAL_CLIENT_ID=placeholder_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=placeholder_paypal_sandbox_client_secret
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_WEBHOOK_ID=placeholder_paypal_webhook_id

# Public Web Application (Vite)
WEB_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:3000
VITE_AUTH0_DOMAIN=dev-example.us.auth0.com
VITE_AUTH0_CLIENT_ID=placeholder_auth0_spa_client_id
VITE_AUTH0_AUDIENCE=https://velvetai.example/api
