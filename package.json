{
  "name": "velvetai-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --concurrency=1",
    "test:sandbox:e2e": "vitest run packages/application/src/__tests__/payment-lifecycle.test.ts -t \"Opt-in sandbox test\"",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "dev": "turbo run dev",
    "start": "turbo run dev",
    "auth:provision-test-user": "tsx scripts/provision-test-user.ts",
    "auth:provision-agent-client": "tsx scripts/provision-agent-client.ts",
    "mcp:smoke": "tsx scripts/mcp-external-smoke.ts",
    "dev:catalog": "tsx scripts/manage-dev-catalog.ts",
    "dev:catalog:confirm": "tsx scripts/manage-dev-catalog.ts --confirm",
    "ai:list-models": "tsx scripts/list-gemini-models.ts",
    "db:migrate": "pnpm --filter @velvetai/db db:migrate",
    "db:test:prepare": "tsx scripts/prepare-test-db.ts",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@modelcontextprotocol/client": "2.3.1",
    "eslint": "^9.21.0",
    "prettier": "^3.5.3",
    "tsx": "^4.19.3",
    "turbo": "^2.4.4",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0",
    "vitest": "^3.0.8"
  }
}
