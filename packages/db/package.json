{
  "name": "@velvetai/db",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --fileParallelism=false",
    "db:migrate": "tsx src/run-migrations.ts"
  },
  "dependencies": {
    "@velvetai/contracts": "workspace:*",
    "@velvetai/observability": "workspace:*",
    "kysely": "^0.27.5",
    "pg": "^8.13.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/pg": "^8.11.11",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
